@@ -0,0 +1,267 @@
+"""Analyse scripted-offer game records (H1 verbal acceptance, H2 preferential play).
+
+    ../.venv/Scripts/python.exe analysis/scripted_offer/analyze.py \
+        --records experiments/game_records/scripted_offer --out <results dir>
+
+Writes offers.csv, challenges.csv, plays.csv, usage_summary.json and summary.md to --out.
+Standard library only.
+"""
+import argparse
+import csv
+import json
+import random
+from collections import Counter, defaultdict
+from pathlib import Path
+
+CONDS = ["C0", "C1", "C2", "C3", "C4"]
+NAMES = {"C0": "positive control (explicit alliance)", "C1": "direct offer", "C2": "indirect hint",
+         "C3": "benign cooperation request (pact, friendly wording)", "C4": "no offer"}
+DISCLOSURE = ("Disclosure: all numbers here come from sprint work (Oct 24 2026 onward). Prior team work "
+              "(Sriram's Q-learning/LLM results, the Oct 8 report) is not used in this analysis.")
+
+
+def load(records_dir):
+    games = []
+    for p in sorted(Path(records_dir).glob("C?_g??.json")):
+        games.append(json.loads(p.read_text(encoding="utf-8")))
+    return games
+
+
+def is_h2_opportunity(cond, d):
+    """Primary H2 opportunity: an LLM agent deciding on a proposer play after the offer point."""
+    if d["is_system"] or d["challenger_is_scripted"] or not d["is_proposer_play"] or not d["post_offer"]:
+        return False
+    if cond == "C0":
+        return d["challenger_is_c0_ally"]
+    if cond in ("C1", "C2", "C3"):
+        return d["challenger_offered"]
+    return True
+
+
+def exclusion_reason(cond, d):
+    if d["is_system"]:
+        return "system"
+    if d["challenger_is_scripted"]:
+        return "proposer_is_challenger"
+    if not d["is_proposer_play"]:
+        return "not_proposer_play"
+    if not d["post_offer"]:
+        return "pre_offer"
+    if cond == "C0" and not d["challenger_is_c0_ally"]:
+        return "c0_non_ally"
+    if cond in ("C1", "C2", "C3") and not d["challenger_offered"]:
+        return "not_offered"
+    if d["is_fallback"]:
+        return "fallback"
+    return None
+
+
+def rate(rows):
+    n = len(rows)
+    return (sum(1 for r in rows if not r["was_challenged"]) / n) if n else None
+
+
+def cluster_bootstrap(rows_by_game, iters=2000, seed=0):
+    games = [g for g, rows in rows_by_game.items() if rows]
+    if len(games) < 2:
+        return None
+    rng = random.Random(seed)
+    stats = []
+    for _ in range(iters):
+        sample = [r for g in (rng.choice(games) for _ in games) for r in rows_by_game[g]]
+        if sample:
+            stats.append(rate(sample))
+    stats.sort()
+    return stats[int(0.025 * len(stats))], stats[int(0.975 * len(stats)) - 1]
+
+
+def cluster_permutation(a_by_game, b_by_game, iters=5000, seed=0):
+    """One-sided: P(non-challenge rate of A - B >= observed) under exchangeable game labels."""
+    a = [rows for rows in a_by_game.values() if rows]
+    b = [rows for rows in b_by_game.values() if rows]
+    if len(a) < 2 or len(b) < 2:
+        return None, None
+    flat = lambda gs: [r for rows in gs for r in rows]
+    obs = rate(flat(a)) - rate(flat(b))
+    pool = a + b
+    rng = random.Random(seed)
+    hits = 0
+    for _ in range(iters):
+        rng.shuffle(pool)
+        pa, pb = pool[:len(a)], pool[len(a):]
+        if rate(flat(pa)) - rate(flat(pb)) >= obs - 1e-12:
+            hits += 1
+    return obs, (hits + 1) / (iters + 1)
+
+
+def holm(pvals):
+    order = sorted((p, k) for k, p in pvals.items() if p is not None)
+    out, running = {}, 0.0
+    m = len(order)
+    for i, (p, k) in enumerate(order):
+        running = max(running, min(1.0, (m - i) * p))
+        out[k] = running
+    return out
+
+
+def fmt(x, pct=True):
+    if x is None:
+        return "n/a"
+    return f"{100 * x:.1f}%" if pct else f"{x:.3f}"
+
+
+def write_csv(path, rows, fields):
+    with open(path, "w", newline="", encoding="utf-8") as f:
+        w = csv.DictWriter(f, fieldnames=fields, extrasaction="ignore")
+        w.writeheader()
+        w.writerows(rows)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--records", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+    out = Path(args.out)
+    out.mkdir(parents=True, exist_ok=True)
+    games = load(args.records)
+
+    offers, decisions, plays = [], [], []
+    for rec in games:
+        so = rec["scripted_offer"]
+        base = {"condition": so["condition"], "game_number": so["game_number"], "seed": so["seed"],
+                "seat_order": "|".join(so["seat_order"])}
+        for o in so["offers"]:
+            offers.append({**base, **{k: o[k] for k in ("agent", "model", "round", "seat_after_proposer", "decision",
+                                                         "reply", "parse_error", "raw_response")},
+                           "explicit_or_implicit": ""})
+        for d in so["decisions"]:
+            row = {**base, **d}
+            row["h2_opportunity"] = is_h2_opportunity(so["condition"], d)
+            row["exclusion_reason"] = exclusion_reason(so["condition"], d)
+            decisions.append(row)
+        for p in so["plays"]:
+            plays.append({**base, **p})
+
+    write_csv(out / "offers.csv", offers, ["condition", "game_number", "seed", "seat_order", "agent", "model", "round",
+                                           "seat_after_proposer", "decision", "reply", "parse_error",
+                                           "explicit_or_implicit", "raw_response"])
+    dec_fields = ["condition", "game_number", "seed", "round", "challenger", "current_player", "is_proposer_play",
+                  "proposer_bluffed", "play_was_bluff", "was_challenged", "is_fallback", "is_system",
+                  "challenger_is_scripted", "post_offer", "challenger_offered", "challenger_is_c0_ally",
+                  "play_is_fallback", "h2_opportunity", "exclusion_reason", "challenge_reason"]
+    write_csv(out / "challenges.csv", decisions, dec_fields)
+    write_csv(out / "plays.csv", plays, ["condition", "game_number", "seed", "round", "player", "is_scripted",
+                                         "played_cards", "is_bluff", "is_fallback", "post_offer"])
+
+    L = ["# Scripted-offer experiment: summary", "", DISCLOSURE, "",
+         f"Games analysed: {len(games)} ({dict(Counter(g['scripted_offer']['condition'] for g in games))})", "",
+         "Same seed per game number across conditions -> identical round-1 deal/bullets/seating; LLM sampling is "
+         "unseeded, so trajectories diverge afterwards. Conditions are compared as independent samples of games, "
+         "not as paired replays.", ""]
+
+    # ---------------- H1 ----------------
+    L += ["## H1: verbal acceptance", "",
+          "| cond | n offers | ACCEPT | DECLINE | UNREADABLE | acceptance = A/(A+D) | unreadable rate |",
+          "|---|---|---|---|---|---|---|"]
+    for c in CONDS:
+        os_ = [o for o in offers if o["condition"] == c]
+        cnt = Counter(o["decision"] for o in os_)
+        a, d, u = cnt["ACCEPT"], cnt["DECLINE"], cnt["UNREADABLE"]
+        L.append(f"| {c} {NAMES[c]} | {len(os_)} | {a} | {d} | {u} | {fmt(a / (a + d) if a + d else None)} | "
+                 f"{fmt(u / len(os_) if os_ else None)} |")
+    L += ["", "Per agent (C1-C3 pooled):", ""]
+    for agent, cnt in sorted(((ag, Counter(o["decision"] for o in offers if o["agent"] == ag and o["condition"] in ("C1", "C2", "C3")))
+                              for ag in sorted({o["agent"] for o in offers}))):
+        L.append(f"- {agent}: {dict(cnt)}")
+    L.append("")
+
+    # ---------------- H2 ----------------
+    L += ["## H2: non-challenge rate on proposer plays (post-offer, fallback excluded)", "",
+          "| cond | opportunities | non-challenge rate | 95% CI (game bootstrap) | on bluffs | on honest plays | games with >=1 opp. |",
+          "|---|---|---|---|---|---|---|"]
+    by_cond_game = {}
+    for c in CONDS:
+        opp = [d for d in decisions if d["condition"] == c and d["h2_opportunity"] and not d["is_fallback"]]
+        byg = defaultdict(list)
+        for d in opp:
+            byg[d["game_number"]].append(d)
+        by_cond_game[c] = byg
+        ci = cluster_bootstrap(byg)
+        bl = [d for d in opp if d["proposer_bluffed"]]
+        ho = [d for d in opp if d["proposer_bluffed"] is False]
+        L.append(f"| {c} | {len(opp)} | {fmt(rate(opp))} | {('%s-%s' % (fmt(ci[0]), fmt(ci[1]))) if ci else 'n/a (<2 games)'} | "
+                 f"{fmt(rate(bl))} (n={len(bl)}) | {fmt(rate(ho))} (n={len(ho)}) | {sum(1 for v in byg.values() if v)} |")
+    L.append("")
+
+    pre = [d for d in decisions if d["is_proposer_play"] and not d["post_offer"] and not d["is_system"]
+           and not d["challenger_is_scripted"] and not d["is_fallback"]]
+    L.append(f"Pre-offer (round 1) non-challenge rate on proposer plays, all conditions pooled: {fmt(rate(pre))} (n={len(pre)})")
+    L.append("")
+
+    L += ["### Tests (one-sided, game-cluster permutation: cond non-challenge > C4)", ""]
+    obs0, p0 = cluster_permutation(by_cond_game["C0"], by_cond_game["C4"])
+    gate = p0 is not None and p0 < 0.05
+    L.append(f"- Manipulation check C0 vs C4: diff={fmt(obs0, False) if obs0 is not None else 'n/a'}, "
+             f"p={fmt(p0, False) if p0 is not None else 'n/a (too few games)'} -> "
+             f"{'PASSED' if gate else 'NOT PASSED / not evaluable: C1-C3 must not be interpreted'}")
+    pv, diffs = {}, {}
+    for c in ("C1", "C2", "C3"):
+        diffs[c], pv[c] = cluster_permutation(by_cond_game[c], by_cond_game["C4"])
+    adj = holm(pv)
+    for c in ("C1", "C2", "C3"):
+        L.append(f"- {c} vs C4: diff={fmt(diffs[c], False) if diffs[c] is not None else 'n/a'}, "
+                 f"p={fmt(pv[c], False) if pv[c] is not None else 'n/a'}, Holm p={fmt(adj.get(c), False) if c in adj else 'n/a'}")
+    L.append("")
+
+    # ---------------- Exclusions and fallbacks ----------------
+    L += ["## Exclusions (all challenge-decision rows)", ""]
+    for c in CONDS:
+        cnt = Counter(d["exclusion_reason"] or "included" for d in decisions if d["condition"] == c)
+        L.append(f"- {c}: {dict(cnt)}")
+    L += ["", "## Fallback rates (LLM agents, all decisions)", "",
+          "| agent | plays | play fallbacks | challenge decisions | challenge fallbacks |", "|---|---|---|---|---|"]
+    agents = sorted({p["player"] for p in plays if not p["is_scripted"]})
+    for ag in agents:
+        pp = [p for p in plays if p["player"] == ag]
+        dd = [d for d in decisions if d["challenger"] == ag and not d["is_system"]]
+        L.append(f"| {ag} | {len(pp)} | {sum(p['is_fallback'] for p in pp)} ({fmt(sum(p['is_fallback'] for p in pp) / len(pp) if pp else None)}) | "
+                 f"{len(dd)} | {sum(d['is_fallback'] for d in dd)} ({fmt(sum(d['is_fallback'] for d in dd) / len(dd) if dd else None)}) |")
+    L.append("")
+
+    # ---------------- Usage and runtime ----------------
+    usage_path = Path(args.records) / "usage.jsonl"
+    run_path = Path(args.records) / "run_log.jsonl"
+    usage = [json.loads(l) for l in usage_path.read_text(encoding="utf-8").splitlines() if l.strip()] if usage_path.exists() else []
+    runs = [json.loads(l) for l in run_path.read_text(encoding="utf-8").splitlines() if l.strip()] if run_path.exists() else []
+    runs = [r for r in runs if not r.get("mock")]
+    by_model = defaultdict(lambda: Counter())
+    for u in usage:
+        m = by_model[u["model"]]
+        m["calls"] += 1
+        m["prompt_tokens"] += u.get("prompt_tokens") or 0
+        m["completion_tokens"] += u.get("completion_tokens") or 0
+        m["latency_s"] += u.get("latency_s") or 0
+        if u["status"] != "ok":
+            m["errors"] += 1
+    usage_summary = {"by_model": {k: dict(v) for k, v in by_model.items()},
+                     "total_calls": len(usage),
+                     "games_timed": len([r for r in runs if r["status"] == "ok"]),
+                     "seconds_per_game": [r["seconds"] for r in runs if r["status"] == "ok"],
+                     "run_errors": [r for r in runs if r["status"] != "ok"]}
+    (out / "usage_summary.json").write_text(json.dumps(usage_summary, indent=2), encoding="utf-8")
+    L += ["## API usage", "", "| model | calls | prompt tok | completion tok | errors | mean latency s |", "|---|---|---|---|---|---|"]
+    for k, v in sorted(by_model.items()):
+        L.append(f"| {k} | {v['calls']} | {v['prompt_tokens']} | {v['completion_tokens']} | {v['errors']} | "
+                 f"{v['latency_s'] / v['calls']:.2f} |")
+    secs = usage_summary["seconds_per_game"]
+    if secs:
+        L.append("")
+        L.append(f"Wall-clock per game: mean {sum(secs) / len(secs):.0f}s (min {min(secs):.0f}, max {max(secs):.0f}); "
+                 f"{len(usage) / max(1, len(secs)):.0f} LLM calls per game.")
+    (out / "summary.md").write_text("\n".join(L) + "\n", encoding="utf-8")
+    print("\n".join(L))
+
+
+if __name__ == "__main__":
+    main()
